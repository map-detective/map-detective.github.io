{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[a-zA-Z0-9_-]{20,64}$/)",
        ".write": "$room.matches(/^[a-zA-Z0-9_-]{20,64}$/) && (data.exists() || (__HOST_CONDITION__))",

        "playerName": {
          "$player": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          }
        },

        "playersCounter": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
        },

        "size": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
        }
      }
    }
  }
}
